cation/x-debian-package","state":"uploaded","size":2179564,"digest":"sha256:f7c92764cef7427f5a3b0dd5c0925782c62c3250e7de75e12aaf404382e750ca","download_count":46,"created_at":"2026-10-11T02:39:31Z","updated_at":"2026-10-11T02:39:31Z","browser_download_url":"https://github.com/junegunn/fzf/releases/download/v0.74.5/fzf_0.74.5_riscv64.deb"},{"url":"https://api.github.com/repos/junegunn/fzf/releases/assets/629581850","id":629581850,"node_id":"RA_kwDOANKv9s4lhqga","name":"fzf_0.74.5_s390x.deb","label":"","uploader":{"login":"junegunn","id":700826,"node_id":"MDQ6VXNlcjcwMDgyNg==","avatar_url":"https://avatars.githubusercontent.com/u/700826?v=4","gravatar_id":"","url":"https://api.github.com/users/junegunn","html_url":"https://github.com/junegunn","followers_url":"https://api.github.com/users/junegunn/followers","following_url":"https://api.github.com/users/junegunn/following{/other_user}","gists_url":"https://api.github.com/users/junegunn/gists{/gist_id}","starred_url":"https://api.github.com/users/junegunn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/junegunn/subscriptions","organizations_url":"https://api.github.com/users/junegunn/orgs","repos_url":"https://api.github.com/users/junegunn/repos","events_url":"https://api.github.com/users/junegunn/events{/privacy}","received_events_url":"https://api.github.com/users/junegunn/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/x-debian-package","state":"uploaded","size":2227802,"digest":"sha256:ef201e04c1bee0bc5053ba7bf987c7570d0af24be8558ed764fa3ad1016324dc","download_count":48,"created_at":"2026-10-11T02:39:30Z","updated_at":"2026-10-11T02:39:30Z","browser_download_url":"https://github.com/junegunn/fzf/releases/download/v0.74.5/fzf_0.74.5_s390x.deb"}],"tarball_url":"https://api.github.com/repos/junegunn/fzf/tarball/v0.74.5","zipball_url":"https://api.github.com/repos/junegunn/fzf/zipball/v0.74.5","body":"- Fixed `--popup` unzooming the window when opened over a zoomed pane on tmux 3.8 or above (#4927, junegunn/fzf.vim#1625) (@jereviikari)\n    - On tmux 3.7, the window is still unzoomed, as tmux 3.7b crashes when a floating pane is created over a zoomed window\n- Fixed `--gap-line` cutting a grapheme cluster when filling the last cells of the line (#4920)\n- Fixed an escape sequence fzf does not recognize being partly consumed, which leaked the rest into the query (#4926)\n- Fixed a key lost when it arrived in the same read as an escape sequence\n- Fixed `focus` event not triggered after `reload` when the new item is at the same position as the previous one (#4930)\n    - With `--id-nth`, the event is not triggered if the focus moves directly from an item to another item with the same key\n    - A `focus` binding that runs `reload` now triggers itself again after each reload, unless `--id-nth` is set and the key does not change\n- Security fixes\n    - fzf-tmux no longer evaluates an attached layout size (e.g. `-l50`) via bash arithmetic, which could run commands or inject tmux flags (GHSA-w6x2-f5m4-xw82)\n    - zsh completion now creates its FIFO in a private `mktemp -d` directory instead of a predictable `/tmp` path (GHSA-7rj6-7pqx-v7rm)\n    - Reported by Sai Sreewathsa Kovalluri, Shon Babu, and Kannan K (Researchers) of Innspark Solutions\n\n","reactions":{"url":"https://api.github.com/repos/junegunn/fzf/releases/409351989/reactions","total_count":32,"+1":12,"-1":0,"laugh":1,"hooray":7,"confused":0,"heart":6,"rocket":5,"eyes":1},"mentions_count":1}